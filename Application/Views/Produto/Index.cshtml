@model List<SistemaVenda.Models.ProdutoFormViewModel>

@{
    ViewData["Title"] = "Produtos";
}

<h2>@ViewData["Title"]</h2>
<br />

<div>
    <a asp-action="Cadastro" class="btn btn-primary">Cadastrar Produto</a>
</div>
<br />

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model[0].Codigo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model[0].Descricao)
            </th>
            <th>
                @Html.DisplayNameFor(model => model[0].Quantidade)
            </th>
            <th>
                @Html.DisplayNameFor(model => model[0].Valor)
            </th>
            <th>
                Categoria
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Codigo</td>
                <td>@item.Descricao</td>
                <td>@item.Quantidade</td>
                <td>@item.Valor</td>
                <td>@item.Categoria.Descricao</td>
                <td>
                    <a asp-action="Editar" asp-route-id="@item.Codigo">Editar</a>
                    <a asp-action="Deletar" asp-route-id="@item.Codigo">Deletar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<br />
